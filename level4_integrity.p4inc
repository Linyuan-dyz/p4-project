// level4_integrity.p4inc
// Level 4: integrity reporting + winner filtering for polymorphic paths
// 说明：
//   - 放在 basic.p4 同目录，在 MyIngress 内部通过
//         #include "level4_integrity.p4inc"
//     引入。
//   - basic.p4 需要：
//       header integrity_report_t { bit<32> flow_hash; bit<16> integrity_tag; bit<8> modal_id; }
//       struct metadata { ip4Addr_t dst_ipv4; bit<32> flow_hash; bit<16> integrity_tag; bit<8> modal_id; bit<8> winner_modal; }
//       struct headers {..., integrity_report_t integrity_report; }
//       const bit<32> L4_INTEGRITY_CLONE_SESSION = 100;

action l4_compute_flow_and_payload_hash() {
    if (hdr.ipv4.isValid()) {
        hash(meta.flow_hash,
             HashAlgorithm.crc32,
             32w0,
             { hdr.ipv4.srcAddr,
               hdr.ipv4.dstAddr,
               hdr.ipv4.protocol });

        hash(meta.integrity_tag,
             HashAlgorithm.crc16,
             16w0,
             { hdr.ipv4.srcAddr,
               hdr.ipv4.dstAddr,
               hdr.ipv4.protocol,
               hdr.ipv4.totalLen });
    }
}

action l4_clone_to_cpu() {
    if (hdr.ipv4.isValid()) {
        hdr.integrity_report.setValid();
        hdr.integrity_report.flow_hash     = meta.flow_hash;
        hdr.integrity_report.integrity_tag = meta.integrity_tag;
        hdr.integrity_report.modal_id      = meta.modal_id;
        clone3(CloneType.I2E, L4_INTEGRITY_CLONE_SESSION, { });
    }
}

action l4_set_winner(bit<8> winner_modal) {
    meta.winner_modal = winner_modal;
}

table l4_integrity_winner {
    key = {
        meta.flow_hash : exact;
    }
    actions = {
        l4_set_winner;
        NoAction;
    }
    size = 1024;
    default_action = NoAction();
}

action l4_drop_if_not_winner() {
    if (meta.winner_modal != 0 && meta.modal_id != 0) {
        if (meta.modal_id != meta.winner_modal) {
            mark_to_drop(standard_metadata);
        }
    }
}

